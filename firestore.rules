rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notification settings — own only
    match /notificationSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Alerts — users can only read/write their own alerts
    match /alerts/{alertId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Scan jobs — authenticated users can create and read; any authenticated user can update (scan engine runs client-side)
    match /scans/{scanId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Assets — any authenticated user can read/write (populated by scan engine)
    match /assets/{assetId} {
      allow read, write: if request.auth != null;
    }

    // Findings — any authenticated user can read/write (populated by scan engine)
    match /findings/{findingId} {
      allow read, write: if request.auth != null;
    }

    // Reports — any authenticated user can create/read; update own reports
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.generatedBy;
    }

    // Integrations — keyed by userId_type, only owner can read/write
    match /integrations/{integrationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.connectedBy;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.connectedBy;
    }

    // Risk history — own snapshots only
    match /riskHistory/{docId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Team invites — sender owns invite, recipient can read by email query
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.invitedBy ||
        request.auth.token.email == resource.data.invitedEmail
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.invitedBy;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.invitedBy ||
        request.auth.token.email == resource.data.invitedEmail
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.invitedBy;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
